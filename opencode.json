{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "edit": "allow",
    "bash": {
      "*": "ask",
      "./scripts/check.sh*": "allow",
      "git status*": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "git add*": "allow",
      "git commit*": "allow",
      "git push*": "ask",
      "git reset --hard*": "deny",
      "rm -rf*": "deny"
    },
    "external_directory": "deny"
  },
  "agent": {
    "build": { "temperature": 0.2 },
    "plan":  { "temperature": 0.1 }
  }
}
